# =============================================================================
#  VedicDhaam frontend (Next.js): copy to .env.local (dev) or .env.production (server)
#  NEXT_PUBLIC_* values are embedded in the browser bundle at build time:
#  set them BEFORE `npm run build`.
# =============================================================================

# Public API base used by the browser (must be listed in the backend's CLIENT_URLS CORS whitelist)
NEXT_PUBLIC_API_URL=https://api.vedicdhaam.com/api/v1

# API base used by the Next.js server for server-rendered pages. Can be an internal/private URL
# (e.g. http://127.0.0.1:5000/api/v1 when both run on one machine). The API must be reachable during `npm run build`.
API_URL=https://api.vedicdhaam.com/api/v1

# Canonical site URL (SEO metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://vedicdhaam.com

# AI palm reading at /palmistry (server-only, never NEXT_PUBLIC_). Set ONE of these keys.
# Gemini is used when GEMINI_API_KEY is set; get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pin a Gemini model (default: gemini-flash-latest)
# GEMINI_MODEL=
# Otherwise Claude is used: https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=
